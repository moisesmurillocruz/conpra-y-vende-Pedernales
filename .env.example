# Hash SHA-256 del correo del propietario en minusculas y sin espacios.
# Ejemplo para generar: node -e "console.log(require('crypto').createHash('sha256').update('dueno@correo.com').digest('hex'))"
OWNER_EMAIL_SHA256=

# Hash SHA-256 de la clave del propietario. No guardar la clave real en texto plano.
# Ejemplo para generar: node -e "console.log(require('crypto').createHash('sha256').update('clave-segura').digest('hex'))"
OWNER_PASSWORD_SHA256=

# Puerto del servidor seguro que valida /api/auth/login y sirve dist/.
PORT=4173
